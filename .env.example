# ============================================================
# league-predict Web 层环境变量清单（唯一出处）
# 复制为 .env 后填写真实值。仓库内任何文件不得出现真实敏感值。
# 未设置的键全部有安全默认值（见 web/config.py），可裸启动。
# ============================================================

# --- 服务 ---
# 监听地址与端口（开发用；云端部署由平台注入，可忽略）
WEB_HOST=127.0.0.1
WEB_PORT=8000

# --- 会话认证（单账号）---
# 部署时改为强口令；placeholder 仅用于本地/测试。
AUTH_USERNAME=admin
AUTH_PASSWORD=<your-strong-password>

# 会话 TTL 秒（默认 12h = 43200）
SESSION_TTL_SECONDS=43200
# 访问时惰性清理过期会话行（1 开 / 0 关）
SESSION_CLEANUP_ON_ACCESS=1

# --- 登录限速 ---
# 连续失败 N 次后锁定窗口 W 秒（默认 5 次 / 600 秒）
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=600

# --- Cookie / CORS ---
# 部署在 https 后置 1：cookie 加 Secure、CORS 只放行 https 来源
USE_HTTPS=0
# 逗号分隔的允许来源；留空 = 不启用 CORS（同源最安全）
CORS_ORIGINS=

# --- 会话存储 ---
# SQLite 会话库路径；默认 web/.data/sessions.db（gitignore 已排除）
SESSION_DB_PATH=
